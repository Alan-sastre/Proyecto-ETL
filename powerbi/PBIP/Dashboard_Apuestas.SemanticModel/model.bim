                "        Table.RenameColumns(Encabezado, {{Primera, Text.TrimStart(Primera, \"#(feff)\")}})",
                "    else",
                "        Encabezado,",
                "    Saneado = Table.ReplaceValue(SinBom, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(SinBom)),",
                "    Tipado = Table.TransformColumnTypes(",
                "        Saneado,",
                "        {{\"id_evento\", type text}, {\"id_fecha\", type text}, {\"fecha_evento\", type date}, {\"id_deporte\", type text}, {\"id_competicion\", type text}, {\"id_equipo_local\", type text}, {\"id_equipo_visitante\", type text}, {\"marcador_local\", Int64.Type}, {\"marcador_visitante\", Int64.Type}, {\"goles_local\", type number}, {\"goles_visitante\", type number}, {\"puntos_local\", Int64.Type}, {\"puntos_visitante\", Int64.Type}, {\"diferencia_marcador\", Int64.Type}, {\"resultado_normalizado\", type text}, {\"cuota_local\", type number}, {\"cuota_empate\", type number}, {\"cuota_visitante\", type number}, {\"cuota_favorita\", type number}, {\"favorito\", type text}, {\"prob_implicita_local\", type number}, {\"prob_implicita_empate\", type number}, {\"prob_implicita_visitante\", type number}, {\"margen_mercado\", type number}, {\"fuente_archivo\", type text}},",
