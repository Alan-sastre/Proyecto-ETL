          },
          {
            "name": "Partidos como Visitante",
            "expression": [
              "CALCULATE (",
              "    [Total Eventos],",
              "    USERELATIONSHIP ( fact_eventos[id_equipo_visitante], dim_equipos[id_equipo] )",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "fe200153-a2d1-5759-b578-a9d6d39353c9"
          },
          {
            "name": "Partidos Totales Equipo",
            "expression": [
              "[Total Eventos] + [Partidos como Visitante]"
            ],
            "formatString": "#,##0",
            "lineageTag": "da9467b4-e042-5eba-8d92-20eabbc4b025"
          },
          {
            "name": "Victorias Equipo",
            "expression": [
              "CALCULATE ( [Total Eventos], fact_eventos[resultado_normalizado] = \"Local\" )",
              "+ CALCULATE (",
              "    [Total Eventos],",
              "    fact_eventos[resultado_normalizado] = \"Visitante\",",
              "    USERELATIONSHIP ( fact_eventos[id_equipo_visitante], dim_equipos[id_equipo] )",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "33b34710-c74f-5067-ab2a-125e082f1365"
          },
          {
            "name": "Empates Equipo",
            "expression": [
              "CALCULATE ( [Total Eventos], fact_eventos[resultado_normalizado] = \"Empate\" )",
              "+ CALCULATE (",
              "    [Total Eventos],",
              "    fact_eventos[resultado_normalizado] = \"Empate\",",
              "    USERELATIONSHIP ( fact_eventos[id_equipo_visitante], dim_equipos[id_equipo] )",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "9ec012ec-11e8-547b-9c1d-697acd1c6164"
          },
          {
            "name": "Derrotas Equipo",
            "expression": [
              "[Partidos Totales Equipo] - [Victorias Equipo] - [Empates Equipo]"
            ],
            "formatString": "#,##0",
            "lineageTag": "b26685f6-9d76-517b-bc64-1c2ac506f763"
          },
          {
            "name": "% Victorias Equipo",
            "expression": [
              "DIVIDE ( [Victorias Equipo], [Partidos Totales Equipo] )"
            ],
            "formatString": "0.0%",
            "lineageTag": "f44db160-fb9b-5b37-805d-455ec61ee87d"
          },
          {
            "name": "Ranking Equipos",
            "expression": [
              "RANKX (",
              "    ALLSELECTED ( dim_equipos[id_equipo] ),",
              "    [Partidos Totales Equipo],",
              "    ,",
              "    DESC,",
              "    DENSE",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "f31458a9-e031-50ab-a43c-31e50ceb3064"
          }
        ]
      }
